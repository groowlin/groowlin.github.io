# Static portfolio does not require runtime secrets by default.
# Optional: keep this file for local overrides if needed.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# Server-side build flag. Use true locally to enable games; Pages forces false.
ENABLE_GAMES=false

# Used only by scripts/analytics-collect.mjs. Never expose this token to client code.
YANDEX_METRICA_TOKEN=
YANDEX_METRICA_COUNTER_ID=

# Optional report comparability markers.
ANALYTICS_TRACKING_CONTRACT_VERSION=
ANALYTICS_RELEASE_MARKER=
